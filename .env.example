DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-32-plus-random-bytes
