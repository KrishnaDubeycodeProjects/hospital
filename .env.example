EVOLUTION_API_URL=
EVOLUTION_API_KEY=
INSTANCE_NAME=clinic-bot

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
RATE_LIMIT_CREATE_TOKEN_PER_MINUTE=20

ASYNC_CORE_POOL_SIZE=4
