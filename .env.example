# Copy to .env and fill in real values. Never commit the real .env.
# See README.md for what each variable does.

PORT=5000

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
CLINIC_NAME=qDischarge
AVG_SERVICE_MINUTES=10
TOKEN_EXPIRY_HOURS=24

DB_DATABASE=clinic_queue
DB_USER=postgres
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-32-plus-random-bytes
JWT_EXPIRY_MINUTES=720
WEBHOOK_VERIFY_TOKEN=clinic_queue_token

WA_PROVIDER=meta
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v25.0
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
INSTANCE_NAME=clinic-bot

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
RATE_LIMIT_CREATE_TOKEN_PER_MINUTE=20

ASYNC_CORE_POOL_SIZE=4
ASYNC_MAX_POOL_SIZE=16
ASYNC_QUEUE_CAPACITY=500

# --- Geo / distance-based notification ---
GEO_AVG_SPEED_KMH=25
NOTIFY_MIN_TOKENS=2
NOTIFY_MAX_TOKENS=12

# --- Hospital location (DIGIPIN, or lat/lon to derive one) ---
HOSPITAL_URI_SLUG=main
HOSPITAL_DIGIPIN=
HOSPITAL_LATITUDE=
HOSPITAL_LONGITUDE=
HOSPITAL_OPEN_TIME=09:00
HOSPITAL_CLOSE_TIME=17:00
HOSPITAL_ACTIVE_COUNTERS=1

# --- OTP verification ---
# OTP_PROVIDER=log (dev: code is logged, not sent), twilio (real SMS via Twilio
# Verify), or twilio-sms (self-generated code sent via Twilio's plain Messages
# API + a Messaging Service, instead of the Verify API).
OTP_PROVIDER=log
OTP_REQUIRED_FOR_REGISTRATION=false
TWILIO_ACCOUNT_SID=ACdummy0000000000000000000000000
TWILIO_AUTH_TOKEN=dummy_auth_token
TWILIO_VERIFY_SERVICE_SID=VAdummy00000000000000000000000000
# Only needed for OTP_PROVIDER=twilio-sms
TWILIO_MESSAGING_SERVICE_SID=
OTP_TTL_MINUTES=10
RATE_LIMIT_OTP_PER_MINUTE=5
