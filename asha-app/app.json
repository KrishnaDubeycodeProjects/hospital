{
  "expo": {
    "name": "Aarogya Flow",
    "slug": "aarogya-flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aarogya_flow_logo_hd.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/aarogya_flow_logo_hd.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "package": "com.jansamvaad.aarogyaflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/aarogya_flow_logo_hd.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/aarogya_flow_logo_hd.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-speech-recognition"
    ],
    "owner": "krishnadubeycomp",
    "extra": {
      "eas": {
        "projectId": "50696879-d279-4194-a7a3-f2d556ab84bf"
      }
    }
  }
}
