{
  "expo": {
    "name": "Aarogya Flow",
    "slug": "aarogya-flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aarogya_flow_logo_hd.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/aarogya_flow_logo_hd.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jansamvaad.aarogyaflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/aarogya_flow_logo_hd.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/aarogya_flow_logo_hd.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "dfe954de-c57e-41af-89bd-d80d97fde939"
      }
    },
    "owner": "krishnacomp",
    "plugins": [
      "expo-speech-recognition"
    ]
  }
}
