# Read automatically by `vite build` for production builds (e.g. Vercel).
# Without this, client.js falls back to window.location.origin --
# https://www.princete.com -- which has no backend behind it, so every API
# call from the deployed site fails. This must point at wherever the Spring
# Boot backend is actually reachable from the internet.
#
# CAUTION: ngrok's free tier hands out a NEW random URL every time the tunnel
# restarts, so this value goes stale the next time `ngrok` is relaunched.
# Claim ngrok's one free static domain (dashboard.ngrok.com/domains) and run
# `ngrok http 8088 --domain=<your-static-domain>.ngrok-free.app` instead, so
# this only ever needs to be set once. Until then, update this after every
# ngrok restart and redeploy.
VITE_API_URL=https://decency-immovable-synopsis.ngrok-free.dev
